# Optional configuration reference.
# Copy any values you want from here into your real .env file. Every variable below has a
# working default, so .env.example alone is enough to run the bot.
#
# Layout: seven tiers, ordered by how often an administrator edits them. Tier 1 is everyday
# behavior; tier 7 only matters for 24/7 production hosts, a VPS, or cloud deployments
# (e.g. Azure, AWS). Within a tier, variables are grouped into "## Section" blocks by subsystem.
#
# Adding a variable: see docs/en/contributing/extending/env-variable.md for the tier decision
# tree and naming conventions. Always place new knobs in an existing section when applicable,
# and document units and defaults.
#
# Every entry states its unit and default in a comment unless the section note covers both.
# Prose follows the repo comment policy: no prose em dashes or en dashes.

###############################################################################
# RUNTIME MODE
# Sets which environment the bot believes it is in. It silently changes the meaning of
# several variables below, most notably the network egress flags, so set it before tuning.
###############################################################################

# Default is development. Set to production only on a deployed host.
RUN_ENV=development

###############################################################################
# TIER 1: BOT IDENTITY AND EVERYDAY BEHAVIOR
# Knobs that shape what Tomori says or how she behaves, with no infrastructure implications.
###############################################################################

## Bot identity
# Emergency fallback when no loaded locale provides general.defaults.bot_name.
DEFAULT_BOTNAME=Tomori
# Chat trigger detection uses this global list.
BASE_TRIGGER_WORDS=tomori,tomo,トモリ,ともり

## Emoji usage
# Penalty and deduplication for custom server emojis (:name:).
EMOJI_PENALTY_ENABLED=true
EMOJI_UNIQUE_ENABLED=true
# When false, unknown :name: emojis are stripped; when true, sent as plain text.
EMOJI_PRESERVE_UNRESOLVED_SHORTCODES=false

## Short-term memory
STM_JANITOR_RETENTION_DAYS=90

## Reaction context
# Include per-message reaction metadata in LLM context when budget allows.
REACTION_CONTEXT_ENABLED=true

## Persona sprites
PERSONA_SPRITE_MAX_PER_PERSONA=50
PERSONA_SPRITE_MESSAGE_RETENTION_DAYS=30

## Random triggers and reminders
RANDOM_TRIGGER_MAX_PER_SERVER=10

###############################################################################
# TIER 2: OPTIONAL FEATURES AND INTEGRATIONS
# Opt-in external features and integrations. Leaving a credential or base URL
# blank keeps the feature off.
###############################################################################

## Web search
# HTTP request budget (ms) for external search engines
WEB_SEARCH_TIMEOUT_MS=5000
BRAVE_IMAGE_DISCORD_LIMIT_MB=8
BRAVE_IMAGE_DOWNLOAD_MAX_MB=25

## URL fetching
FETCH_URL_ENGINE_ORDER=safe_http
FETCH_URL_TIMEOUT_MS=15000
FETCH_URL_MAX_CONTENT_LENGTH=50000
# Positive integer MiB; invalid values use 5 in production or 50 in development.
MAX_FETCH_SIZE_MB=5
FETCH_URL_FILTER_MODE=fit

## Network egress security
# Both allow-flags auto-relax in development. Defaults are safe for production.
# Set true only if production must permit fetch_url to reach private or internal networks.
FETCH_URL_ALLOW_PRIVATE_NETWORK=false
USER_REMOTE_FETCH_MAX_REDIRECTS=3

## Documents and RAG
# Auto-enabled when pgvector is present. Size values are MB, text is characters.
MAX_DOCUMENT_SIZE_MB=4
MAX_DOCUMENT_TEXT_LENGTH=120000
MAX_DOCUMENT_CHUNKS=150
MAX_DOCUMENTS_PER_SERVER=20
MAX_DOCUMENT_CHUNKS_PER_SERVER=1000
CHAT_DOCUMENT_MAX_SIZE_MB=8
CHAT_DOCUMENT_MAX_TEXT_LENGTH=200000
MAX_DOCUMENT_OPERATIONS_PER_DAY=20

## MCP servers
MAX_MCP_SERVERS_PER_GUILD=10
GUILD_MCP_CONNECTION_TTL_MINUTES=10
GUILD_MCP_CONNECT_TIMEOUT_MS=15000
GUILD_MCP_EXECUTION_TIMEOUT_MS=30000
GUILD_MCP_FAILURE_COOLDOWN_MS=300000

## Matrix appservice bridge
# Leave blank to disable. Setup guide: docs/en/architecture/integrations/matrix/bridge.md.
# Token roles: MATRIX_ACCESS_TOKEN = as_token, MATRIX_HS_TOKEN = hs_token.
MATRIX_HOMESERVER_URL=
MATRIX_ACCESS_TOKEN=
MATRIX_BOT_USER_ID=
MATRIX_SERVER_NAME=
MATRIX_HS_TOKEN=
MATRIX_APPSERVICE_PUBLIC_URL=
MATRIX_APPSERVICE_PORT=9993
MATRIX_MAX_ATTACHMENT_MB=8
MATRIX_MEDIA_TIMEOUT_MS=15000

## Object storage (S3 compatible)
# Shared credentials. Leave bucket names blank to keep assets in local storage.
# For Cloudflare R2: set S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com and region "auto".
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Custom expression media: local, gcs, or s3. Cloud backends require their own bucket.
# Local bytes live under data/custom-expressions. S3 uses AWS_REGION and optional S3_ENDPOINT.
EXPRESSION_STORAGE_BACKEND=local
EXPRESSION_STORAGE_BUCKET=
# Maximum custom expressions per server, including links (default: 20, minimum: 1).
MAX_CUSTOM_EXPRESSIONS_PER_SERVER=20
AWS_REGION=us-east-1
# Voice sample storage (falls back to avatar bucket/region if blank)
VOICE_SAMPLE_S3_BUCKET=
VOICE_SAMPLE_S3_REGION=
VOICE_SAMPLE_S3_PREFIX=voice-samples
VOICE_SAMPLE_PUBLIC_BASE_URL=
# Persona avatar storage (falls back to local data/avatars if blank)
AVATAR_S3_BUCKET=
AVATAR_S3_REGION=
AVATAR_S3_PREFIX=avatars
AVATAR_PUBLIC_BASE_URL=
# Character reference storage for /novelai charreference (falls back to avatar bucket/region if blank)
CHARREF_S3_BUCKET=
CHARREF_S3_REGION=
CHARREF_S3_PREFIX=charreferences
CHARREF_PUBLIC_BASE_URL=

## GitHub release feed
GITHUB_REPO=Bredrumb/TomoriBot
GITHUB_API_TIMEOUT_MS=10000

## Top.gg server count reporting
TOPGG_TOKEN=

###############################################################################
# TIER 3: SELF-HOSTED LOCAL SERVERS AND SERVICES
# Settings for optional local AI containers, TTS servers, and search servers.
# Configure only the services you run locally.
###############################################################################

## SearXNG
# Self-hosted SearXNG metasearch server URL (e.g. http://searxng:8080). Leave unset to skip.
SEARXNG_BASE_URL=
# Secret key consumed by the SearXNG container (must match servers/searxng/settings.yml).
SEARXNG_SECRET=
SEARXNG_IMAGE_POOL=10
SEARXNG_IMAGE_COUNT=3

## Crawl4AI scraper
# Enable with 'docker compose --profile fetch-crawl4ai up' and set http://crawl4ai:11235/
CRAWL4AI_BASE_URL=
CRAWL4AI_TOKEN=
# JSON array of cookies for authenticated fetches: [{"name":"auth_token","value":"...","domain":".x.com"}]
CRAWL4AI_COOKIES_JSON=

## Text-to-speech local servers (General)
# Reference-clip upload size ceiling. Checked before the duration ceiling, and uncompressed
# stereo WAV spends about 10 MB per minute, so a long DAW export can trip this first.
SPEECH_SAMPLE_MAX_MB=10
# Uploaded reference clip duration ceiling. A per-engine cap still applies where the audio is sent.
SPEECH_SAMPLE_MAX_DURATION_SECS=130
TTS_SYNTHESIZE_TIMEOUT_MS=240000
# How long `bun run launch` waits for a Python local server to report ready.
TOMORI_TTS_STARTUP_TIMEOUT_MS=300000
# Bind address shared by every TTS local server. The servers have no authentication, so bind
# off loopback (for example 0.0.0.0 for a bot in Docker) only on a network you trust.
TOMORI_TTS_HOST=127.0.0.1

## Chatterbox
CHATTERBOX_PORT=8011
CHATTERBOX_FAST_MODEL=turbo

## Qwen3-TTS
# Unset uses 8012, or 8014 when started in voice-design mode.
QWEN3TTS_PORT=

## Irodori-TTS
IRODORI_TTS_PORT=8013
IRODORI_TTS_MODEL_ID=Aratako/Irodori-TTS-v4.1-Small
IRODORI_TTS_CHECKPOINT=
IRODORI_CHUNKING_ENABLED=true
IRODORI_CHUNK_MIN_CHARS=80

## Fish Audio S2 Pro
FISH_S2_PORT=8015
FISH_S2_MODEL_ID=fishaudio/s2-pro
FISH_S2_MODEL_DIR=servers/tts/fishs2/fish-speech/checkpoints/fish-speech-s2-pro
# Installer only: Hugging Face revision of FISH_S2_MODEL_ID to download.
FISH_S2_MODEL_REVISION=main

## VoxCPM2
VOXCPM2_PORT=8016

## MOSS
MOSS_TTS_PORT=8018
MOSS_TTS_CLONE_MODEL_ID=OpenMOSS-Team/MOSS-TTS-Local-Transformer-v1.5
MOSS_TTS_DESIGN_MODEL_ID=OpenMOSS-Team/MOSS-VoiceGenerator
MOSS_TTS_WARM_MODE=clone
MOSS_TTS_DEVICE=cuda
MOSS_TTS_DTYPE=bfloat16
MOSS_TTS_DEFAULT_LANGUAGE=
MOSS_TTS_MAX_NEW_TOKENS=4096

## CosyVoice 3
COSYVOICE3_PORT=8017

## ComfyUI image and video generation
COMFYUI_IMAGE_TARGET_AREA=1048576
COMFYUI_UNLOAD_MODELS_AFTER_SUCCESS=false
COMFYUI_REFERENCE_DENOISE=0.75
COMFYUI_IMG2IMG_DENOISE=0.75
COMFYUI_LANPAINT_STEPS=16
COMFYUI_LANPAINT_NUM_STEPS=3
COMFYUI_LANPAINT_SAMPLER=er_sde
COMFYUI_OUTPAINT_STEPS=20
COMFYUI_OUTPAINT_THINKING_STEPS=2
COMFYUI_OUTPAINT_CFG=3
COMFYUI_OUTPAINT_SAMPLER=euler
COMFYUI_VIDEO_FPS=16
VIDEO_GEN_DEFAULT_DURATION_SECONDS=5
VIDEO_GEN_MAX_DURATION_SECONDS=20
VIDEO_GEN_MAX_FPS=60

## Local OpenAI and ChatMock
CHATMOCK_PORT=8000
CUSTOM_GEMMA_TOOL_PARSER_ENABLED=true
CUSTOM_GEMMA_THINKING_PARSER_ENABLED=true

###############################################################################
# TIER 4: AI PROVIDERS AND MODELS
# Per-provider LLM and image generator tuning.
###############################################################################

## Turn timeouts
# Raise these together for a slow local model: the channel lock is taken once per turn and
# is not renewed while a tool or provider call is still running.
TOOL_EXECUTION_TIMEOUT_MS=300000
STREAM_SDK_CALL_TIMEOUT_MS=120000
CHANNEL_LOCK_TIMEOUT_MS=180000

## Vision captioning
# Wall-clock ceiling for one caption call, covering providers that accept the request and
# then stall. The Discord interaction behind the command has no room to wait longer.
VISION_CAPTION_TIMEOUT_MS=60000

## Google Gemini
GOOGLE_MAX_OUTPUT_TOKENS=8192
GOOGLE_ENABLE_PENALTY_PARAMS=false

## OpenRouter
OPENROUTER_MAX_OUTPUT_TOKENS=8192
OPENROUTER_APP_ATTRIBUTION_ENABLED=true

## NovelAI text generation
NOVELAI_REQUEST_TIMEOUT_MS=60000
NOVELAI_STREAM_READ_TIMEOUT_MS=30000
NAI_GLM_THINKING_ENABLED=true
NAI_GLM_CHAR_PREFIX_ENABLED=true

## Custom OpenAI-compatible providers
CUSTOM_EXPRESSION_BATCH_SIZE=20

## Image generation: NovelAI
NAI_IMAGE_ENABLE_TAG_RESOLUTION=false
NAI_INPAINT_DEBUG=false
NAI_SEGMENTATION_MODEL=gemini-2.5-flash
NAI_SEGMENTATION_TIMEOUT_MS=90000
NAI_ENABLE_CHAR_REFERENCES=true

## Image reference inputs
IMAGE_REFERENCE_MAX_COUNT=3
IMAGE_REFERENCE_MAX_TOTAL_BYTES=6291456
IMAGE_REFERENCE_MAX_SINGLE_BYTES=2097152

###############################################################################
# TIER 5: LIMITS AND QUOTAS
# Caps on counts, sizes, payload lengths, and rates.
###############################################################################

## Persona and memory limits
MAX_PERSONAL_MEMORIES=100
MAX_SERVER_MEMORIES=100
MAX_MEMORY_LENGTH=1000
MAX_PERSONAS_PER_SERVER=20

## Import size limits
# Byte ceiling (MB) for /persona import and export-restore archives
MAX_PERSONA_IMPORT_SIZE_MB=10
MAX_DATA_IMPORT_SIZE_MB=2
MAX_CHARX_IMPORT_SIZE_MB=10
MAX_CHARX_CARD_SIZE_MB=4
MAX_CHARX_ASSETS=500
MAX_CHARX_ASSET_TOTAL_MB=256

## Rate limiting
MAX_USER_ACTIVE_MESSAGES=3
MAX_SERVER_ACTIVE_MESSAGES=10
MAX_FOLLOW_UP_INTERRUPTS=3
# Multiplier on every slash command cooldown (unitless, default: 1). /persona waits 10s,
# most other commands 3s, the rest 1.6s; 0.5 halves them all and 0 turns cooldowns off.
COMMAND_COOLDOWN_SCALE=1

## Images in context
MEDIA_CONTEXT_WINDOW=10
MEDIA_IMAGE_MESSAGE_LIMIT=3
MAX_MEDIA_SIZE_MB=10
MAX_AVATAR_SIZE_MB=10
IMAGE_CONTEXT_MAX_BYTES=2097152
IMAGE_CONTEXT_MAX_DIMENSION=2048
IMAGE_FETCH_TIMEOUT_MS=20000
VISION_ANALYSIS_TIMEOUT_MS=60000

## GIF handling
MAX_GIF_SIZE_MB=50
GIF_PROCESSING_TIMEOUT_MS=30000

## Video in context
VIDEO_CONTEXT_MAX_INLINE_MB=20
PROVIDER_VIDEO_DOWNLOAD_MAX_MB=25

###############################################################################
# TIER 6: DIAGNOSTICS AND DEVELOPMENT TOOLING
# Development tools, debug logs, local testing, and validation gates.
###############################################################################

## Verbose debug logging
OPENROUTER_VERBOSE_FETCH=false
TTS_VOICE_DESIGN_LOG_PAYLOADS=false
TOMORI_TTS_LOG_PAYLOADS=0
TOMORI_TTS_LOG_PREVIEW_CHARS=240

## Usage statistics
STAT_TRACKING_ENABLED=true

## Backup and maintenance scripts
TOMORI_BACKUP_DIR=./backups
TOMORI_ENV_FILE=./.env
TOMORI_AUTO_BACKUP_ENABLED=true
TOMORI_AUTO_BACKUP_INTERVAL_HOURS=24
TOMORI_AUTO_BACKUP_MAX=5
POSTGRES_MAINTENANCE_DB=postgres
TOMORI_NUKE_CONFIRM=
TOMORI_RESTORE_CONFIRM=
TOMORI_RESTORE_FORCE_NONEMPTY=

## Validation and lint gates
TOMORI_VL_ALLOW_NONLOCAL_DB=false
TOMORI_VL_AUDIT_TIMEOUT_MS=60000

## Comment audit calibration
# Thresholds for the two heuristic rules `bun run audit-comments` adds on top of the
# deterministic checks. They exist for maintainer recalibration when the report stops being
# readable, not for routine use: leave them unset and the calibrated defaults below apply.
# Only this audit reads them, so they never affect runtime behavior. Units and defaults are
# stated per variable. Guide: docs/en/contributing/policies/comments.md.
# Minimum words in a comment block before an exact repeat counts as a duplicate (default: 12).
COMMENT_AUDIT_DUPLICATE_MIN_WORDS=12
# Minimum characters in the same block, so a run of identifiers cannot reach the word floor
# (default: 60).
COMMENT_AUDIT_DUPLICATE_MIN_CHARS=60
# Rendered lines in one consecutive `//` block before the length rule reports it (default: 11).
COMMENT_AUDIT_LONG_BLOCK_LINES=11

## Tokenizer assets
TOKENIZER_ASSET_DIR=./tokenizers

## Test database
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=your_test_password

###############################################################################
# TIER 7: PRODUCTION HOSTING AND OPERATIONS
# Relevant for 24/7 cloud (e.g. Azure, AWS), VPS, and dedicated production hosts.
# Standard local docker-compose.yaml users can skip this tier.
# Deep architectural rationale and incident tuning: docs/en/wiki/production-tuning.md.
###############################################################################

## Container sizing
# Consumed by deploy/azure/docker-compose.yml (ignored by root docker-compose.yaml).
TOMORIBOT_MEMORY_LIMIT_MB=1536
TOMORIBOT_MEMORY_SWAP_LIMIT_MB=3072
TOMORIBOT_PIDS_LIMIT=256
SEARXNG_MEMORY_LIMIT_MB=512
SEARXNG_PIDS_LIMIT=128
# Upstream concurrency for SearXNG worker; keep 1 on memory-constrained hosts (default: 1).
SEARXNG_BLOCKING_THREADS=1

## In-process memory guard
# Baseline container memory ceiling (MB) for memory guard thresholds (default: 1024).
CONTAINER_MEMORY_LIMIT_MB=1024
MEMORY_WARNING_THRESHOLD=0.75
MEMORY_CRITICAL_THRESHOLD=0.85
MEMORY_MONITOR_INTERVAL_MS=30000
EMERGENCY_COOLDOWN_MS=60000
EMERGENCY_CACHE_CLEAR_ENABLED=true
EMERGENCY_CACHE_CLEAR_INCLUDE_STM=false
EMERGENCY_CACHE_CLEAR_DISCORD_VOLATILE=true

## Image processing (libvips)
# Native memory settings for sharp/libvips. Concurrency drives peak usage (default: 1).
SHARP_CONCURRENCY=1
SHARP_CACHE_MEMORY_MB=16
SHARP_CACHE_ITEMS=50
SHARP_CACHE_FILES=0

## PostgreSQL connection pool
# Production pool lifecycle and retry knobs. Recycles idle connections before cloud
# gateways (e.g. Azure Flexible Server) reap them. Seconds unless MS is specified.
POSTGRES_IDLE_TIMEOUT_SECONDS=180
POSTGRES_MAX_LIFETIME_SECONDS=1800
POSTGRES_CONNECTION_TIMEOUT_SECONDS=10
POSTGRES_POOL_MAX=10
# Retry attempts for transient pool retirement errors (default: 3, min: 1; 1 disables).
POSTGRES_TRANSIENT_RETRY_ATTEMPTS=3
# Maximum randomized jitter wait before transient retry in milliseconds (default: 100, min: 0).
POSTGRES_TRANSIENT_RETRY_DELAY_MS=100
# Quiet period before logging a new pool retirement episode in milliseconds (default: 60000).
POOL_EVENT_EPISODE_QUIET_MS=60000

## Schema management
DATABASE_SCHEMA_MANAGEMENT_ENABLED=true

## Observability sinks
CACHE_METRICS_INTERVAL_MS=300000
METRIC_SAMPLE_RETENTION_DAYS=30
METRIC_SAMPLE_PRUNE_INTERVAL_MS=21600000

# Host pressure detector (evaluates PSI and swap-in; see docs/en/wiki/production-tuning.md).
PRESSURE_ELEVATED_IO_FULL=15
PRESSURE_CRITICAL_IO_FULL=30
PRESSURE_RECOVERY_IO_FULL=5
PRESSURE_MIN_SWAP_IN_PER_S=1
PRESSURE_ELEVATED_DWELL_MS=3600000
PRESSURE_CRITICAL_DWELL_MS=1800000
PRESSURE_MIN_DUTY_CYCLE=0.95
PRESSURE_STARTUP_GRACE_MS=900000
PRESSURE_MIN_ACTION_INTERVAL_MS=21600000
PRESSURE_DETECTOR_ARMED=false

# Error database logging and circuit breaker
ERROR_DB_LOGGING_ENABLED=true
ERROR_DB_LOGGING_BREAKER_THRESHOLD=5
ERROR_DB_LOGGING_BREAKER_COOLDOWN_MS=60000
ERROR_LOG_RETENTION_DAYS=90
ERROR_LOG_PRUNE_INTERVAL_MS=21600000

EVENT_LOOP_SAMPLE_INTERVAL_MS=1000
# Optional append-only JSONL log file destination (used when pino-pretty is inactive).
TOMORI_LOG_FILE=
# Optional string character length cap in logs. Unset by default (full prompts and stack traces preserved; base64 payloads are collapsed automatically).
LOG_MAX_STRING_LENGTH=
# Directory for on-demand SIGUSR2 Chrome DevTools heap dumps (default: unset).
# Snapshots can contain credentials and private conversations. Use a separate directory outside
# log shipping, owned by the bot user (POSIX: directory 0700, files 0600; Windows: private ACL).
# Restrict access, remove snapshots after diagnosis, then unset this value and restart the bot.
HEAP_SNAPSHOT_DIR=
GRAFANA_PASSWORD=admin

## Official persona preset avatar sync
PRESET_AVATAR_SYNC_ENABLED=true
PRESET_AVATAR_SYNC_DELAY_MS=3000
PRESET_AVATAR_SYNC_API_TIMEOUT_MS=15000
PRESET_AVATAR_SYNC_MAX_PER_RUN=0
