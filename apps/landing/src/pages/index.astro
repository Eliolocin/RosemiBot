---
import { DOCS_LOCALES } from "../../../../src/constants/docsLocales";
import packageJson from "../../../../package.json";
import { landingCopyByLocale } from "../landingCopy";

const requestedLocale = typeof Astro.props.locale === "string" ? Astro.props.locale : "en";
const locale = DOCS_LOCALES.find((entry) => entry.id === requestedLocale && entry.docsTree) ?? DOCS_LOCALES[0];
const copy = landingCopyByLocale[locale.id] ?? landingCopyByLocale.en;
const pagePath = locale.id === "en" ? "/" : `/${locale.id}/`;
const pageUrl = `https://tomoribot.app${pagePath}`;
const landingUrl = (localeId: string) => `https://tomoribot.app${localeId === "en" ? "/" : `/${localeId}/`}`;
const localeFlags: Record<string, string> = {
  en: "/img/flags/en.svg",
  ja: "/img/flags/ja.svg",
  "zh-TW": "/img/flags/zh-TW.svg",
  "zh-CN": "/img/flags/zh-CN.svg",
  "es-419": "/img/flags/es-419.svg",
  "pt-BR": "/img/flags/pt-BR.svg",
  vi: "/img/flags/vi.svg",
};
const docsLocales = DOCS_LOCALES.filter((locale) => locale.docsTree).map((locale) => ({
  ...locale,
  flag: localeFlags[locale.id] ?? "/img/flags/es-419.svg",
}));
const features = [
  {
    image: "/img/features/01-multiple-personas.png",
    href: `https://docs.tomoribot.app/${locale.id}/features/chatting-personality/multiple-personas/`,
  },
  {
    image: "/img/features/02-memory.png",
    href: `https://docs.tomoribot.app/${locale.id}/features/knowledge/memory/`,
  },
  {
    image: "/img/features/03-media-generation.png",
    href: `https://docs.tomoribot.app/${locale.id}/features/capabilities/media-generation/`,
  },
  {
    image: "/img/features/04-agentic-tools.png",
    href: `https://docs.tomoribot.app/${locale.id}/features/capabilities/tools-and-extensions/`,
  },
  {
    image: "/img/features/05-fully-local-setup.png",
    href: `https://docs.tomoribot.app/${locale.id}/self-hosting/local-endpoints/`,
  },
  {
    image: "/img/features/06-server-moderation.png",
    href: `https://docs.tomoribot.app/${locale.id}/features/setup-administration/server-moderation/`,
  },
  {
    image: "/img/features/07-command-reference.png",
    href: `https://docs.tomoribot.app/${locale.id}/features/command-reference/`,
  },
  {
    image: "/img/features/08-sillytavern-support.png",
    href: `https://docs.tomoribot.app/${locale.id}/features/integrations/sillytavern-support/`,
  },
] as const;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "TomoriBot",
  url: pageUrl,
  image: "https://tomoribot.app/img/social-banner.png",
  description: copy.description,
  applicationCategory: "CommunicationApplication",
  operatingSystem: "Web",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  sameAs: ["https://github.com/Bredrumb/TomoriBot", "https://discord.gg/bjCfHm9QsB"],
});
---

<!doctype html>
<html lang={locale.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <link rel="canonical" href={pageUrl} />
    {docsLocales.map((alternateLocale) => (
      <link rel="alternate" hreflang={alternateLocale.lang} href={landingUrl(alternateLocale.id)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={landingUrl("en")} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:image" content="https://tomoribot.app/img/social-banner.png" />
    <script type="application/ld+json" set:html={structuredData} />
    <script is:inline>
      const storedTheme = localStorage.getItem("starlight-theme");
      const theme = storedTheme === "light" || storedTheme === "dark"
        ? storedTheme
        : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <header>
      <a class="brand" href={landingUrl(locale.id)} aria-label={copy.home}>
        <img src="/tomoricon.svg" alt="" width="32" height="32" />
        <span translate="no">TomoriBot</span>
      </a>
      <div class="header-controls">
        <nav class="social-links" aria-label={copy.links}>
          <a href="https://github.com/Bredrumb/TomoriBot" rel="me" aria-label="GitHub">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z" />
            </svg>
          </a>
          <a href="https://discord.gg/bjCfHm9QsB" rel="me" aria-label="Discord">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M20.32 4.37a19.8 19.8 0 0 0-4.93-1.51 13.78 13.78 0 0 0-.64 1.28 18.27 18.27 0 0 0-5.5 0 12.64 12.64 0 0 0-.64-1.28h-.05A19.74 19.74 0 0 0 3.64 4.4 20.26 20.26 0 0 0 .11 18.09l.02.02a19.9 19.9 0 0 0 6.04 3.03l.04-.02a14.24 14.24 0 0 0 1.23-2.03.08.08 0 0 0-.05-.07 13.1 13.1 0 0 1-1.9-.92.08.08 0 0 1 .02-.1 10.2 10.2 0 0 0 .41-.31h.04a14.2 14.2 0 0 0 12.1 0l.04.01a9.63 9.63 0 0 0 .4.32.08.08 0 0 1-.03.1 12.29 12.29 0 0 1-1.9.91.08.08 0 0 0-.02.1 15.97 15.97 0 0 0 1.27 2.01h.04a19.84 19.84 0 0 0 6.03-3.05v-.03a20.12 20.12 0 0 0-3.57-13.69ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.34-.96 2.42-2.16 2.42Zm7.97 0c-1.18 0-2.15-1.08-2.15-2.42 0-1.33.95-2.42 2.15-2.42 1.22 0 2.18 1.1 2.16 2.42 0 1.34-.94 2.42-2.16 2.42Z" />
            </svg>
          </a>
          <a href="https://ko-fi.com/bredrumb" rel="me" aria-label={copy.support}>
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015Z" />
            </svg>
          </a>
        </nav>
        <label class="header-select theme-select">
          <span class="sr-only">{copy.theme}</span>
          <svg class="select-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z" />
          </svg>
          <select data-theme-select autocomplete="off">
            <option value="dark">{copy.dark}</option>
            <option value="light">{copy.light}</option>
            <option value="auto">{copy.automatic}</option>
          </select>
          <svg class="select-caret" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z" />
          </svg>
        </label>
        <label class="header-select language-select">
          <span class="sr-only">{copy.language}</span>
          <svg class="select-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M8.516 3a.94.94 0 0 0-.941.94v1.15H2.94a.94.94 0 1 0 0 1.882h7.362a7.422 7.422 0 0 1-1.787 3.958 7.42 7.42 0 0 1-1.422-2.425.94.94 0 1 0-1.774.627 9.303 9.303 0 0 0 1.785 3.043 7.422 7.422 0 0 1-4.164 1.278.94.94 0 1 0 0 1.881 9.303 9.303 0 0 0 5.575-1.855 9.303 9.303 0 0 0 4.11 1.74l-.763 1.525a.968.968 0 0 0-.016.034l-1.385 2.77a.94.94 0 1 0 1.683.841l1.133-2.267h5.806l1.134 2.267a.94.94 0 0 0 1.683-.841l-1.385-2.769a.95.95 0 0 0-.018-.036l-3.476-6.951a.94.94 0 0 0-1.682 0l-1.82 3.639a7.423 7.423 0 0 1-3.593-1.256 9.303 9.303 0 0 0 2.27-5.203h1.894a.94.94 0 0 0 0-1.881H9.456V3.94A.94.94 0 0 0 8.516 3Zm6.426 11.794a1.068 1.068 0 0 1-.02.039l-.703 1.407h3.924l-1.962-3.924-1.24 2.478Z" clip-rule="evenodd" />
          </svg>
          <select data-language-select autocomplete="off" value={locale.id}>
            {docsLocales.map((language) => <option value={language.id}>{language.label}</option>)}
          </select>
          <svg class="select-caret" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z" />
          </svg>
        </label>
      </div>
    </header>

    <main>
      <section class="hero">
        <div>
          <h1>{copy.heading}</h1>
          <p class="tagline">
            {copy.description} <strong>{copy.developmentStatus} (v{packageJson.version}).</strong>
          </p>
          <div class="actions">
            <a class="primary" href={`https://docs.tomoribot.app/${locale.id}/introduction/`}>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M21.17 2.06A13.1 13.1 0 0 0 19 1.87a12.94 12.94 0 0 0-7 2.05 12.94 12.94 0 0 0-7-2 13.1 13.1 0 0 0-2.17.19 1 1 0 0 0-.83 1v12a1 1 0 0 0 1.17 1 10.9 10.9 0 0 1 8.25 1.91l.12.07h.11a.91.91 0 0 0 .7 0h.11l.12-.07A10.899 10.899 0 0 1 20.83 16 1 1 0 0 0 22 15V3a1 1 0 0 0-.83-.94ZM11 15.35a12.87 12.87 0 0 0-6-1.48H4v-10c.333-.02.667-.02 1 0a10.86 10.86 0 0 1 6 1.8v9.68Zm9-1.44h-1a12.87 12.87 0 0 0-6 1.48V5.67a10.86 10.86 0 0 1 6-1.8c.333-.02.667-.02 1 0v10.04Z" />
              </svg>
              {copy.readDocs}
            </a>
            <a
              class="secondary"
              href="https://discord.com/oauth2/authorize?client_id=841644102059556915">
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M20.32 4.37a19.8 19.8 0 0 0-4.93-1.51 13.78 13.78 0 0 0-.64 1.28 18.27 18.27 0 0 0-5.5 0 12.64 12.64 0 0 0-.64-1.28h-.05A19.74 19.74 0 0 0 3.64 4.4 20.26 20.26 0 0 0 .11 18.09l.02.02a19.9 19.9 0 0 0 6.04 3.03l.04-.02a14.24 14.24 0 0 0 1.23-2.03.08.08 0 0 0-.05-.07 13.1 13.1 0 0 1-1.9-.92.08.08 0 0 1 .02-.1 10.2 10.2 0 0 0 .41-.31h.04a14.2 14.2 0 0 0 12.1 0l.04.01a9.63 9.63 0 0 0 .4.32.08.08 0 0 1-.03.1 12.29 12.29 0 0 1-1.9.91.08.08 0 0 0-.02.1 15.97 15.97 0 0 0 1.27 2.01h.04a19.84 19.84 0 0 0 6.03-3.05v-.03a20.12 20.12 0 0 0-3.57-13.69ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.34-.96 2.42-2.16 2.42Zm7.97 0c-1.18 0-2.15-1.08-2.15-2.42 0-1.33.95-2.42 2.15-2.42 1.22 0 2.18 1.1 2.16 2.42 0 1.34-.94 2.42-2.16 2.42Z" />
              </svg>
              {copy.invite}
            </a>
            <a class="text-link" href="https://github.com/Bredrumb/TomoriBot">
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z" />
              </svg>
              {copy.viewGitHub}
            </a>
          </div>
        </div>
        <img class="hero-image" src="/tomoricon.svg" alt={copy.heroImage} width="240" height="240" />
      </section>

      <section class="showcase" aria-label={copy.showcase}>
        <div class="gallery-stage">
          <div class="gallery-viewport" data-gallery-viewport tabindex="0">
            <ol class="gallery-track">
              {
                features.map((feature, index) => {
                  const featureCopy = copy.features[index];
                  return (
                  <li class="gallery-slide" data-gallery-slide>
                    <button
                      class="gallery-image-frame"
                      type="button"
                      data-gallery-trigger
                      data-gallery-index={index}
                      aria-label={`${copy.viewFeature} ${featureCopy.title}. ${copy.galleryInstruction}`}
                    >
                      <img
                        src={feature.image}
                        alt={`TomoriBot ${featureCopy.title}`}
                        loading={index === 0 ? "eager" : "lazy"}
                        decoding="async"
                      />
                    </button>
                    <div class="gallery-caption">
                      <h2><a href={feature.href}>{featureCopy.title}</a></h2>
                      <p>{featureCopy.description}</p>
                    </div>
                  </li>
                  );
                })
              }
            </ol>
          </div>
        </div>
        <div class="gallery-dots" aria-label={copy.chooseFeature}>
          {
            features.map((feature, index) => (
              <button
                type="button"
                data-gallery-dot
                data-gallery-index={index}
                aria-label={`${copy.viewFeature} ${copy.features[index].title}`}
              />
            ))
          }
        </div>
      </section>

      <section class="read-more" aria-label={copy.documentationLanguages}>
        <p class="section-copy">{copy.guide}</p>
        <nav class="language-grid" aria-label={copy.documentationLanguages}>
          {
            docsLocales.map((language) => (
              <a href={`https://docs.tomoribot.app/${language.id}/introduction/`} lang={language.lang}>
                <span class="language-label"><img src={language.flag} alt="" width="24" height="16" />{language.label}</span>
                <small>{language.id}</small>
              </a>
            ))
          }
        </nav>
      </section>
    </main>

    <script>
      const viewport = document.querySelector<HTMLElement>("[data-gallery-viewport]");
      const slides = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
      const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-gallery-trigger]"));
      const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-gallery-dot]"));
      const themeSelect = document.querySelector<HTMLSelectElement>("[data-theme-select]");
      const languageSelect = document.querySelector<HTMLSelectElement>("[data-language-select]");
      let activeIndex = 0;

      const updateControls = (index: number) => {
        activeIndex = index;
        for (const [dotIndex, dot] of dots.entries()) {
          dot.toggleAttribute("aria-current", dotIndex === index);
        }
        for (const [slideIndex, slide] of slides.entries()) {
          slide.toggleAttribute("data-active", slideIndex === index);
        }
      };

      // Smooth scrolling is slow, so the observer would report stale slides mid-flight and
      // rapid clicks or keys would compute their target from the wrong index.
      let navigating = false;
      let navigationTimer: ReturnType<typeof setTimeout> | undefined;
      const NAVIGATION_SETTLE_MS = 700;

      const finishNavigation = () => {
        clearTimeout(navigationTimer);
        navigating = false;
      };

      const showSlide = (index: number) => {
        const targetIndex = Math.max(0, Math.min(index, slides.length - 1));
        const slide = slides[targetIndex];
        if (!viewport || !slide) return;
        navigating = true;
        clearTimeout(navigationTimer);
        navigationTimer = setTimeout(finishNavigation, NAVIGATION_SETTLE_MS);
        updateControls(targetIndex);
        const centeredOffset = slide.offsetLeft - (viewport.clientWidth - slide.clientWidth) / 2;
        viewport.scrollTo({ left: centeredOffset, behavior: "smooth" });
      };

      for (const trigger of triggers) {
        trigger.addEventListener("click", (event) => {
          const slideIndex = Number(trigger.dataset.galleryIndex);
          if (slideIndex !== activeIndex) {
            showSlide(slideIndex);
            return;
          }
          if (event.detail === 0) return;

          const bounds = trigger.getBoundingClientRect();
          const direction = event.clientX < bounds.left + bounds.width / 2 ? -1 : 1;
          showSlide(activeIndex + direction);
        });
      }

      for (const dot of dots) {
        dot.addEventListener("click", () => showSlide(Number(dot.dataset.galleryIndex)));
      }

      if (viewport) {
        // Listening on the whole section keeps arrows working after focus lands on a dot or slide button.
        viewport.closest(".showcase")?.addEventListener("keydown", (event) => {
          const { key } = event as KeyboardEvent;
          if (key !== "ArrowLeft" && key !== "ArrowRight") return;
          event.preventDefault();
          showSlide(activeIndex + (key === "ArrowLeft" ? -1 : 1));
        });

        viewport.addEventListener("scrollend", finishNavigation);

        const observer = new IntersectionObserver(
          (entries) => {
            if (navigating) return;
            const visible = entries.find((entry) => entry.isIntersecting);
            if (!visible) return;
            const index = slides.indexOf(visible.target as HTMLElement);
            if (index >= 0) updateControls(index);
          },
          { root: viewport, threshold: 0.6 },
        );
        for (const slide of slides) observer.observe(slide);
      }

      const systemTheme = matchMedia("(prefers-color-scheme: light)");
      const applyTheme = (theme: string) => {
        const selectedTheme = theme === "light" || theme === "dark" ? theme : "auto";
        document.documentElement.dataset.theme = selectedTheme === "auto"
          ? systemTheme.matches ? "light" : "dark"
          : selectedTheme;
        localStorage.setItem("starlight-theme", selectedTheme === "auto" ? "" : selectedTheme);
      };

      if (themeSelect) {
        const storedTheme = localStorage.getItem("starlight-theme");
        themeSelect.value = storedTheme === "light" || storedTheme === "dark" ? storedTheme : "auto";
        themeSelect.addEventListener("change", () => applyTheme(themeSelect.value));
        systemTheme.addEventListener("change", () => {
          if (themeSelect.value === "auto") applyTheme("auto");
        });
      }

      languageSelect?.addEventListener("change", () => {
        window.location.href = languageSelect.value === "en" ? "/" : `/${languageSelect.value}/`;
      });

      updateControls(0);
    </script>
  </body>
</html>

<style>
  :root {
    --tb-red: #e7322a;
    --tb-espresso: #432b26;
    --color-white: #f7f2f1;
    --color-gray-1: #ece0de;
    --color-gray-2: #c7ada9;
    --color-gray-3: #917069;
    --color-gray-4: #63433e;
    --color-gray-5: #3a2420;
    --color-gray-6: #221412;
    --color-black: #160c0b;
    --color-accent: var(--tb-red);
    --color-accent-high: #ffb3af;
    --color-bg: var(--color-black);
    --color-bg-nav: var(--color-gray-6);
    --color-text: var(--color-gray-2);
    --color-heading: var(--color-white);
    --color-text-accent: var(--color-accent-high);
    --color-hairline: var(--color-black);
    color-scheme: dark;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--color-text);
    background: var(--color-bg);
  }

  :root[data-theme="light"] {
    --color-white: var(--tb-espresso);
    --color-gray-1: #3b2724;
    --color-gray-2: #5c4340;
    --color-gray-3: #8a6b67;
    --color-gray-4: #b89b97;
    --color-gray-5: #e8d8d6;
    --color-gray-6: #f5eeec;
    --color-black: #fefaf9;
    --color-accent: #c42820;
